# Frontend env — copy to .env and adjust per environment.

# Backend API base URL (no trailing slash)
VITE_API_URL=http://localhost:3001/api/v1

# Toggle mock API. Set to "false" once backend endpoints exist.
# "true"  → useProducts() etc. return local mock-data
# "false" → useProducts() etc. fetch from VITE_API_URL
VITE_USE_MOCK_API=true
